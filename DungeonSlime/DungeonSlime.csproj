<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Icon.ico" />
    <None Remove="Icon.bmp" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Icon.ico">
      <LogicalName>Icon.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Icon.bmp">
      <LogicalName>Icon.bmp</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Gum.MonoGame" Version="2026.5.8.1" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../MonoGameLibrary/MonoGameLibrary.csproj" />
  </ItemGroup>
  <Target Name="RunContentBuilder" BeforeTargets="BeforeCompile" AfterTargets="ResolveProjectReferences">
    <!-- These must be evaluated here (execute-time), not in a top-level PropertyGroup
         (evaluate-time): $(MonoGamePlatform) is set by MonoGame.Framework.DesktopGL's
         own build targets, which an SDK-style project only imports at the very end -
         after any top-level PropertyGroup has already evaluated. Computing these
         eagerly silently resolved $(MonoGamePlatform) to empty, so content built into
         Content\bin\ instead of Content\bin\DesktopGL\. -->
    <PropertyGroup>
      <_ContentBuilderProject>$(MSBuildThisFileDirectory)..\Content\Content.csproj</_ContentBuilderProject>
      <_ContentOutputDir>$(MSBuildThisFileDirectory)Content\bin\$(MonoGamePlatform)</_ContentOutputDir>
      <_ContentIntermediateDir>$(MSBuildThisFileDirectory)Content\obj\$(MonoGamePlatform)</_ContentIntermediateDir>
    </PropertyGroup>
    <!-- CI pre-builds content once (on Windows, avoiding Wine) and stages it into
         _ContentOutputDir, then passes -p:SkipContentBuild=true so these two steps
         are skipped and the pre-staged files are picked up by the ItemGroup below. -->
    <MSBuild Condition="'$(SkipContentBuild)' != 'true'" Projects="$(_ContentBuilderProject)" Targets="Build" Properties="Configuration=Release" RemoveProperties="RuntimeIdentifier;RuntimeIdentifiers;SelfContained;PublishReadyToRun;PublishSingleFile;PublishTrimmed" />
    <Exec Condition="'$(SkipContentBuild)' != 'true'" Command="dotnet run --project &quot;$(_ContentBuilderProject)&quot; -c Release --no-build -- build -p $(MonoGamePlatform) --workingDir &quot;$(MSBuildThisFileDirectory)..\Content&quot; -s Assets -o &quot;$(_ContentOutputDir.TrimEnd('\'))&quot; -i &quot;$(_ContentIntermediateDir.TrimEnd('\'))&quot;" />
    <ItemGroup>
      <_BuiltContent Include="$(_ContentOutputDir)\**\*.*" />
      <Content Include="@(_BuiltContent)">
        <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>
  </Target>
</Project>